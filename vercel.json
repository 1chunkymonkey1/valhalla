{
  "rewrites": [
    {
      "source": "/((?!api/|src/|@vite/|@react-refresh|@id/|@fs/|node_modules/|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/admin/[...slug].js": {
      "maxDuration": 60
    },
    "api/hub/[...slug].js": {
      "maxDuration": 60
    },
    "api/stripe/[...slug].js": {
      "maxDuration": 30
    },
    "api/aphrodite/[...slug].js": {
      "maxDuration": 30
    }
  }
}
